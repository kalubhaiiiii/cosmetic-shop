<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= category ? category : "All" %> Products - VelvetAura</title>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Montserrat', sans-serif; }
    body { background: #fff; color: #282c3f; }
    
    /* Myntra Style Navbar */
    nav { background: #fff; padding: 15px 50px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e9e9eb; position: sticky; top: 0; z-index: 10; }
    .logo { font-size: 24px; font-weight: 700; color: #ff3f6c; letter-spacing: 1px; }
    nav a { color: #282c3f; text-decoration: none; margin: 0 12px; font-weight: 600; font-size: 14px; }
    nav a:hover { color: #ff3f6c; }
    
    /* Container */
    .container { max-width: 1300px; margin: 20px auto; padding: 0 20px; }
    .page-title { font-size: 20px; font-weight: 700; margin-bottom: 20px; text-transform: uppercase; }
    
    /* Myntra Grid */
    .products { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 20px; }
    
    /* Myntra Card */
    .product-card { background: white; border: 1px solid #f5f5f6; transition: 0.2s; }
    .product-card:hover { box-shadow: 0 2px 16px rgba(0,0,0,0.08); }
    .product-card img { width: 100%; height: 280px; object-fit: cover; }
    .card-info { padding: 12px; }
    .product-card h3 { font-size: 14px; font-weight: 700; color: #282c3f; margin-bottom: 4px; white-space: nowrap; overflow: hidden; }
    .product-card p.desc { font-size: 13px; color: #535766; margin-bottom: 8px; white-space: nowrap; overflow: hidden; }
    .price { font-size: 14px; font-weight: 700; color: #282c3f; margin-bottom: 8px; }
    
    /* Buttons */
    .btn { width: 100%; background: #ff3f6c; color: white; padding: 10px; text-align: center; text-decoration: none; border-radius: 2px; display: block; border: none; cursor: pointer; font-weight: 600; font-size: 14px; margin-top: 8px; }
    .btn:hover { background: #e63660; }
    .btn-details { width: 100%; background: white; color: #ff3f6c; padding: 8px; text-align: center; text-decoration: none; border-radius: 2px; display: block; border: 1px solid #ff3f6c; cursor: pointer; font-weight: 600; font-size: 14px; margin-top: 8px; }
    .btn-details:hover { background: #ff3f6c; color: white; }
    
    .no-product { text-align: center; font-size: 18px; color: #777; grid-column: 1/-1; padding: 50px; }
  </style>
</head>
<body>

  <!-- Myntra Navbar -->
  <nav>
    <div class="logo">VELVETAURA</div>
    <div>
      <a href="/">HOME</a>
      <a href="/products?category=Bangles">BANGLES</a>
      <a href="/products?category=Cosmetics">COSMETICS</a>
      <a href="/products?category=Perfume">PERFUME</a>
    </div>
    <div>
      <a href="/cart">🛒 CART (<%= cart ? cart.length : 0 %>)</a>
    </div>
  </nav>

  <div class="container">
    <h1 class="page-title"><%= category ? category : "All" %> Products</h1>
    
    <div class="products">
        <% if(products.length > 0) { %>
            <% products.forEach(function(product) { %>
                <div class="product-card">
                    <img src="<%= product.image %>" alt="<%= product.name %>">
                    <div class="card-info">
                        <h3><%= product.name %></h3>
                        <p class="desc"><%= product.description %></p>
                        <p class="price">₹<%= product.price %></p>
                        
                        <!-- YE 2 BUTTON ADD KARO -->
                        <a href="/checkout/<%= product._id %>" class="btn">
                            Buy Now
                        </a>
                        <a href="/product/<%= product._id %>" class="btn-details">
                            View Details
                        </a>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <p class="no-product">No products found in this category.</p>
        <% } %>
    </div>
</div>

</body>
</html>