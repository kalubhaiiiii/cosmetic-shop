<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>My Orders | VelvetAura</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
}

body{
background:#f6f6f8;
}

.header{

background:white;
padding:18px 8%;
display:flex;
justify-content:space-between;
align-items:center;
box-shadow:0 2px 12px rgba(0,0,0,.08);

}

.logo{

font-size:28px;
font-weight:700;
color:#e91e63;

}

.home-btn{

text-decoration:none;
background:#e91e63;
color:white;
padding:12px 22px;
border-radius:8px;
font-weight:600;
transition:.3s;

}

.home-btn:hover{

background:#c2185b;

}

.container{

width:90%;
max-width:1100px;
margin:40px auto;

}

.page-title{

font-size:32px;
color:#222;
margin-bottom:30px;

}

.no-order{

background:white;
padding:50px;
border-radius:18px;
text-align:center;
font-size:20px;
box-shadow:0 8px 20px rgba(0,0,0,.08);

}

.order{

background:white;
padding:25px;
border-radius:18px;
display:flex;
gap:25px;
margin-bottom:25px;
align-items:center;
box-shadow:0 8px 20px rgba(0,0,0,.08);
transition:.3s;

}

.order:hover{

transform:translateY(-4px);

}

.order img{

width:150px;
height:150px;
object-fit:cover;
border-radius:15px;
border:1px solid #eee;

}

.details{

flex:1;

}

.details h3{

font-size:24px;
margin-bottom:15px;
color:#222;

}

.details p{

margin:10px 0;
font-size:15px;
color:#555;

}

.price{

font-size:22px;
font-weight:bold;
color:#e91e63;

}

.badge{

display:inline-block;
padding:8px 16px;
border-radius:25px;
font-size:14px;
font-weight:600;

}

.placed{

background:#d1ecf1;
color:#0c5460;

}

.shipped{

background:#fff3cd;
color:#856404;

}

.delivered{

background:#d4edda;
color:#155724;

}

.pending{

color:#ff9800;
font-weight:600;

}

.paid{

color:green;
font-weight:600;

}

.info{

margin-top:15px;
padding-top:15px;
border-top:1px solid #eee;

}

.delivery{

margin-top:12px;
background:#f8fff8;
padding:12px;
border-radius:10px;
color:#2e7d32;
font-weight:600;

}

@media(max-width:768px){

.header{

flex-direction:column;
gap:15px;

}

.order{

flex-direction:column;
text-align:center;

}

.order img{

width:100%;
height:250px;

}

}

</style>

</head>

<body>

<div class="header">

<div class="logo">
VelvetAura
</div>

<a href="/" class="home-btn">
🏠 Continue Shopping
</a>

</div>

<div class="container">

<h1 class="page-title">
🛍 My Orders
</h1>

<% if(orders.length===0){ %>

<div class="no-order">

<h2>No Orders Yet 😔</h2>

<br>

<p>Looks like you haven't placed any order.</p>

</div>

<% } %>

<% orders.forEach(order=>{ %>

<div class="order">

<img src="<%= order.image %>" alt="<%= order.productName %>">

<div class="details">

<h3><%= order.productName %></h3>

<p class="price">
₹<%= order.price %>
</p>

<div class="info">

<p>
<b>Order ID :</b>
<%= order._id %>
</p>

<p>
💳
<b>Payment :</b>
<%= order.paymentMethod %>
</p>

<p>
💰
<b>Payment Status :</b>

<% if(order.paymentStatus==="Paid"){ %>

<span class="paid">Paid</span>

<% } else { %>

<span class="pending"><%= order.paymentStatus %></span>

<% } %>

</p>

<p>

📅
<b>Order Date :</b>

<%= order.createdAt.toDateString() %>

</p>

<p>

📦
<b>Status :</b>

<% if(order.orderStatus==="Delivered"){ %>

<span class="badge delivered">
Delivered
</span>

<% } else if(order.orderStatus==="Out for Delivery"){ %>

<span class="badge shipped">
Out for Delivery
</span>

<% } else if(order.orderStatus==="Shipped"){ %>

<span class="badge shipped">
Shipped
</span>

<% } else if(order.orderStatus==="Packed"){ %>

<span class="badge shipped">
Packed
</span>

<% } else { %>

<span class="badge placed">
Order Placed
</span>

<% } %>

</p>

<div class="delivery">

🚚 Estimated Delivery :
3 - 5 Business Days

</div>

</div>

</div>

</div>

<% }) %>

</div>

</body>
</html>