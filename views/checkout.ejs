<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Secure Checkout | VelvetAura</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
}

body{
background:#f6f6f8;
}

.header{

background:white;
padding:18px 8%;
display:flex;
justify-content:space-between;
align-items:center;
box-shadow:0 2px 15px rgba(0,0,0,.08);

}

.logo{

font-size:28px;
font-weight:700;
color:#e91e63;

}

.secure{

font-size:15px;
color:#666;

}

.checkout{

width:90%;
max-width:1200px;
margin:40px auto;
display:flex;
gap:30px;
align-items:flex-start;
}

.left{

flex:2;
background:white;
padding:35px;
border-radius:18px;
box-shadow:0 8px 25px rgba(0,0,0,.08);

}

.right{

width:380px;
background:white;
padding:30px;
border-radius:18px;
position:sticky;
top:20px;
box-shadow:0 8px 25px rgba(0,0,0,.08);

}

.title{

font-size:28px;
font-weight:700;
margin-bottom:25px;
color:#222;

}

.subtitle{

font-size:17px;
font-weight:600;
margin-bottom:20px;
color:#e91e63;

}

.input{

width:100%;
padding:15px;
margin-bottom:18px;
border:1px solid #ddd;
border-radius:10px;
font-size:15px;
transition:.3s;

}

.input:focus{

border-color:#e91e63;
outline:none;
box-shadow:0 0 10px rgba(233,30,99,.2);

}

textarea{

height:120px;
resize:none;

}

.row{

display:flex;
gap:15px;

}

.row .input{

flex:1;

}

.payment{

margin-top:25px;

}

.payment h3{

margin-bottom:15px;

}

.option{

border:1px solid #ddd;
padding:14px;
border-radius:10px;
margin-bottom:12px;
cursor:pointer;
transition:.3s;

}

.option:hover{

border-color:#e91e63;
background:#fff3f7;

}

.place-btn{

width:100%;
padding:16px;
background:#e91e63;
border:none;
color:white;
font-size:17px;
font-weight:bold;
border-radius:10px;
cursor:pointer;
margin-top:25px;
transition:.3s;

}

.place-btn:hover{

background:#c2185b;

}

.summary-img{

width:100%;
border-radius:15px;
margin-bottom:18px;

}

.product{

font-size:22px;
font-weight:600;
margin-bottom:15px;

}

.price{

font-size:28px;
font-weight:bold;
color:#e91e63;

}

.line{

display:flex;
justify-content:space-between;
margin:15px 0;
font-size:15px;

}

.total{

display:flex;
justify-content:space-between;
font-size:22px;
font-weight:bold;
margin-top:20px;

}

.badge{

margin-top:20px;
background:#ecfff0;
padding:12px;
border-radius:10px;
color:#1b8d3c;
font-weight:600;
text-align:center;

}

@media(max-width:900px){

.checkout{

flex-direction:column;

}

.right{

width:100%;
position:relative;

}

.row{

flex-direction:column;

}

}

</style>

</head>

<body>

<div class="header">

<div class="logo">
VelvetAura
</div>

<div class="secure">
🔒 100% Secure Checkout
</div>

</div>

<div class="checkout">

<div class="left">

<div class="title">
Checkout
</div>

<form action="/place-order" method="POST">

<input type="hidden"
name="productId"
value="<%= product._id %>">

<div class="subtitle">
📍 Delivery Address
</div>

<input
class="input"
type="text"
name="name"
placeholder="Full Name"
required>

<input
class="input"
type="text"
name="phone"
placeholder="Mobile Number"
required>

<textarea
class="input"
name="address"
placeholder="House No, Street, Area"
required></textarea>

<div class="row">

<input
class="input"
type="text"
name="city"
placeholder="City"
required>

<input
class="input"
type="text"
name="pincode"
placeholder="Pincode"
required>

</div>

<div class="payment">

<h3>💳 Payment Method</h3>

<label class="option">

<input
type="radio"
name="payment"
value="COD"
checked>

 Cash On Delivery

</label>

<label class="option">

<input
type="radio"
name="payment"
value="UPI"
disabled>

 UPI (Coming Soon)

</label>

<label class="option">

<input
type="radio"
name="payment"
value="CARD"
disabled>

 Credit / Debit Card (Coming Soon)

</label>

<label class="option">

<input
type="radio"
name="payment"
value="NETBANKING"
disabled>

 Net Banking (Coming Soon)

</label>

</div>

<button class="place-btn">
🛍 Place Order
</button>

</form>

</div>

<!-- RIGHT SIDE -->

<div class="right">

<h2 style="margin-bottom:20px;">
🛒 Order Summary
</h2>

<img
src="<%= product.image %>"
class="summary-img"
alt="<%= product.name %>">

<div class="product">
<%= product.name %>
</div>

<div class="line">
<span>MRP</span>
<span>₹<%= product.price %></span>
</div>

<div class="line">
<span>Discount</span>
<span id="discountAmount" style="color:green;">- ₹0</span>
</div>

<div class="line">
<span>Delivery Charges</span>
<span style="color:green;">FREE</span>
</div>

<hr style="margin:20px 0;">

<h3 style="margin-bottom:10px;">
🎁 Apply Coupon
</h3>

<div style="display:flex;gap:10px;">

<input
type="text"
id="coupon"
placeholder="Enter Coupon Code"
style="
flex:1;
padding:12px;
border:1px solid #ddd;
border-radius:8px;">

<button
type="button"
onclick="applyCoupon()"
style="
padding:12px 20px;
background:#e91e63;
color:white;
border:none;
border-radius:8px;
cursor:pointer;">

Apply

</button>

</div>

<p
id="coupon-msg"
style="
margin-top:10px;
font-size:14px;
font-weight:bold;">
</p>

<hr style="margin:20px 0;">

<div class="total">

<span>Total</span>

<span id="totalPrice" style="color:#e91e63;">
₹<%= product.price %>
</span>

</div>

<div class="badge">

🚚 Estimated Delivery:
<b>3–5 Business Days</b>

</div>

<div style="margin-top:20px;
font-size:14px;
color:#777;
line-height:24px;">

🔒 100% Secure Payment

<br>

💖 Trusted by VelvetAura Customers

<br>

📦 Easy Return & Replacement

</div>

</div>

</div>

<script>

const originalPrice = Number("<%= product.price %>");

function applyCoupon() {

    const coupon = document.getElementById("coupon").value.trim().toUpperCase();

    const msg = document.getElementById("coupon-msg");

    const total = document.getElementById("totalPrice");

    if (coupon === "SAVE10") {

        document.getElementById("discountAmount").innerHTML = "- ₹100";

        const newPrice = Math.max(0, originalPrice - 100);

        total.innerHTML = "₹" + newPrice;

        msg.innerHTML = "✅ Coupon Applied! ₹100 Discount";

        msg.style.color = "green";

    } else {

        document.getElementById("discountAmount").innerHTML = "- ₹0";

        total.innerHTML = "₹" + originalPrice;

        msg.innerHTML = "❌ Invalid Coupon Code";

        msg.style.color = "red";

    }

}

</script>

</body>
</html>