<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VelvetAura - Elegance in Every Detail</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <%- include("partials/navbar") %>

    <!-- Hero Banner Section -->
    <section class="hero">
        <div class="hero-content">
            <h1>Welcome to VelvetAura</h1>
            <p>Elegance in Every Detail</p>
            <a href="#products" class="btn">Shop Now</a>
        </div>
    </section>

    <!-- Categories Section -->
    <section class="categories">
        <div class="container">
            <h2>Shop by Category</h2>
            <div class="category-container">

                <!-- Bangles Card - Clickable banaya -->
                <a href="/products?category=Bangles" class="card">
                    <img src="/images/bangles.jpg" alt="Bangles">
                    <h3>Bangles</h3>
                </a>

                <!-- Cosmetics Card - Clickable banaya -->
                <a href="/products?category=Cosmetics" class="card">
                    <img src="/images/cosmetic.jpg" alt="Cosmetics">
                    <h3>Cosmetics</h3>
                </a>
                <!-- Perfume Card - Naya add kiya -->
<a href="/products?category=Perfume" class="card">
    <img src="/images/perfume.jpg" alt="Perfume">
    <h3>Perfume</h3>
</a>

            </div>
        </div>
    </section>

    <!-- Featured Products Section -->
    <section class="featured" id="products">
        <div class="container">
            <h2>Featured Products</h2>
            <div class="product-grid">
                <% products.forEach(product => { %>
                    <div class="product-card">
                        <img src="<%= product.image %>" alt="<%= product.name %>">
                        <h3><%= product.name %></h3>
                        <p>₹<%= product.price %></p>
                        <button class="btn">Shop Now</button>
                    </div>
                <% }) %>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section class="about">
        <div class="container">
            <h2>About VelvetAura</h2>
            <p>We bring you the finest bangles and cosmetics to make you shine every day.</p>
        </div>
    </section>

    <%- include("partials/footer") %>

</body>
</html>