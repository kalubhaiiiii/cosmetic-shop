<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin Login</title>

<link rel="stylesheet" href="/css/style.css">

<style>

body{
    margin:0;
    padding:0;
    font-family:Arial,Helvetica,sans-serif;
    background:linear-gradient(135deg,#ff9acb,#ffd6e8);
    height:100vh;
}

.login-container{
    display:flex;
    justify-content:center;
    align-items:center;
    height:100vh;
}

.login-box{

    width:380px;
    background:white;
    padding:40px;
    border-radius:20px;
    box-shadow:0 15px 40px rgba(0,0,0,.2);
    text-align:center;

}

.login-box h1{

    color:#e91e63;
    margin-bottom:10px;

}

.login-box p{

    color:#666;
    margin-bottom:30px;

}

.login-box input{

    width:100%;
    padding:15px;
    margin-bottom:18px;
    border:1px solid #ddd;
    border-radius:10px;
    font-size:16px;
    outline:none;

}

.login-box input:focus{

    border-color:#e91e63;

}

.login-box button{

    width:100%;
    padding:15px;
    border:none;
    background:#e91e63;
    color:white;
    font-size:18px;
    border-radius:10px;
    cursor:pointer;
    transition:.3s;

}

.login-box button:hover{

    background:#c2185b;

}

.icon{

    font-size:60px;
    margin-bottom:10px;

}

</style>

</head>
<body>

<div class="login-container">

<div class="login-box">

<div class="icon">
🔒
</div>

<h1>Admin Login</h1>

<p>Welcome Back</p>

<form action="/admin/login" method="POST">

<input
type="text"
name="username"
placeholder="Username"
required>

<input
type="password"
name="password"
placeholder="Password"
required>

<button>
Login
</button>

</form>

</div>

</div>

</body>
</html>